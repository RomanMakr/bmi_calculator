CMakeLists.txt linguist-detectable=false
*.cmake linguist-detectable=false

*.h linguist-detectable=false
*.cc linguist-detectable=false
*.cpp linguist-detectable=false
*.c linguist-detectable=false

# --- Убираем Swift (iOS/macOS) ---
*.swift linguist-detectable=false

*.gradle linguist-detectable=false
*.kts linguist-detectable=false
*.kt linguist-detectable=false

*.html linguist-detectable=false
*.xml linguist-detectable=false
*.plist linguist-detectable=false

*.dart linguist-language=Dart
*.dart linguist-detectable=true

echo "" >> .gitignore
echo "# Platform folders (generated by flutter create)" >> .gitignore
echo "/windows/" >> .gitignore
echo "/linux/" >> .gitignore
echo "/macos/" >> .gitignore
echo "/ios/" >> .gitignore
echo "/android/" >> .gitignore
echo "/web/" >> .gitignore